on boot
    mkdir /data/vendor/nfc_socket 0770 nfc nfc
    mkdir /data/vendor/nfc 0777 nfc nfc
    mkdir /data/vendor/nfc/param 0777 nfc nfc
    wait /sys/nfc/chip_name
    chmod 0666 /dev/tms_nfc
    chown nfc nfc /dev/tms_nfc
    chmod 0666 /sys/nfc/chip_name
    chown nfc nfc /sys/nfc/chip_name

#NFC version compatible
on early-init && property:ro.boot.product.hardware.sku=o19cn
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.secure_display_optim 1
    setprop ro.vendor.se.type eSE,HCE,UICC
    setprop ro.vendor.se.chip.model SN220T
    setprop ro.vendor.se.info 19-1010212

on early-init && property:ro.boot.product.hardware.sku=o19cn_ss
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.nfc.secure_display_optim 1
    setprop ro.vendor.se.type eSE,HCE,UICC
    setprop ro.vendor.se.chip.model SN220T
    setprop ro.vendor.se.info 19-1010212

on early-init && property:ro.boot.product.hardware.sku=o19gl
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=o19gl_ss
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=o19eea
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=o19eea_ss
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=o19jp
    setprop ro.vendor.nfc.secure_display_optim 1
    setprop ro.vendor.se.type eSE,HCE,UICC
    setprop ro.vendor.se.chip.model SN220T
    setprop ro.vendor.se.info 19-1010212

on early-init && property:ro.boot.product.hardware.sku=o19glp
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.se.type HCE,UICC

on early-init && property:ro.boot.product.hardware.sku=o19glp_ss
    setprop ro.vendor.nfc.wallet_fusion 1
    setprop ro.vendor.se.type HCE,UICC
