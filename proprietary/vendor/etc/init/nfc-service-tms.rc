service nfc_hal_service.tms.aidl /vendor/bin/hw/android.hardware.nfc-service-tms
    class hal
    user nfc
    group nfc
    disabled

on boot && property:ro.boot.product.hardware.sku=o19cn
    start nfc_hal_service.tms.aidl

on boot && property:ro.boot.product.hardware.sku=o19cn_ss
    start nfc_hal_service.tms.aidl
